<%- include('../partials/header', { title: 'Products - BeTattoo', page: 'products', cssFile: 'index.css' }) %>

<section style="padding-top: 150px; min-height: 100vh; background: #111;">
  <div class="container" style="max-width: 1200px; margin: 0 auto; padding: 0 20px;">
    
    <!-- Page Header -->
    <div class="text-center mb-5">
      <h2 class="section-title" style="color: #E8BCB5; font-size: 2.5rem; margin-bottom: 1rem;">Our Tattoo Packages</h2>
      <p style="color: #999; font-size: 1.1rem;">Showing <%= products.length %> of <%= total %> products</p>
    </div>

    <!-- Filter Section -->
    <div style="background: #1a1a1a; padding: 2rem; border-radius: 10px; margin-bottom: 3rem; border: 1px solid #333;">
      <form method="GET" action="/products" id="filterForm">
        <div class="row g-3">
          
          <!-- Category Filter -->
          <div class="col-md-3">
            <label style="color: #E8BCB5; display: block; margin-bottom: 0.5rem; font-weight: 500;">Category</label>
            <select name="category" class="form-control" style="background: #111; color: #fff; border: 1px solid #444; padding: 0.5rem; border-radius: 5px; width: 100%;">
              <option value="">All Categories</option>
              <% categories.forEach(cat => { %>
                <option value="<%= cat %>" <%= query.category === cat ? 'selected' : '' %>><%= cat %></option>
              <% }) %>
            </select>
          </div>

          <!-- Min Price Filter -->
          <div class="col-md-3">
            <label style="color: #E8BCB5; display: block; margin-bottom: 0.5rem; font-weight: 500;">Min Price ($)</label>
            <input type="number" name="priceMin" value="<%= query.priceMin || '' %>" placeholder="0" min="0" class="form-control" style="background: #111; color: #fff; border: 1px solid #444; padding: 0.5rem; border-radius: 5px; width: 100%;">
          </div>

          <!-- Max Price Filter -->
          <div class="col-md-3">
            <label style="color: #E8BCB5; display: block; margin-bottom: 0.5rem; font-weight: 500;">Max Price ($)</label>
            <input type="number" name="priceMax" value="<%= query.priceMax || '' %>" placeholder="1000" min="0" class="form-control" style="background: #111; color: #fff; border: 1px solid #444; padding: 0.5rem; border-radius: 5px; width: 100%;">
          </div>

          <!-- Items Per Page -->
          <div class="col-md-3">
            <label style="color: #E8BCB5; display: block; margin-bottom: 0.5rem; font-weight: 500;">Items Per Page</label>
            <select name="limit" class="form-control" style="background: #111; color: #fff; border: 1px solid #444; padding: 0.5rem; border-radius: 5px; width: 100%;">
              <option value="6" <%= limit === 6 ? 'selected' : '' %>>6</option>
              <option value="9" <%= limit === 9 ? 'selected' : '' %>>9</option>
              <option value="12" <%= limit === 12 ? 'selected' : '' %>>12</option>
              <option value="24" <%= limit === 24 ? 'selected' : '' %>>24</option>
            </select>
          </div>
        </div>

        <!-- Filter Buttons -->
        <div class="text-center mt-3">
          <button type="submit" style="background: #E8BCB5; color: #111; padding: 0.7rem 2rem; border: none; border-radius: 5px; cursor: pointer; font-weight: 600; margin-right: 1rem;">Apply Filters</button>
          <a href="/products" style="background: #333; color: #fff; padding: 0.7rem 2rem; border: none; border-radius: 5px; text-decoration: none; display: inline-block;">Clear All</a>
        </div>
      </form>
    </div>

    <!-- Products Grid -->
    <div class="row g-4">
      <% if (products && products.length > 0) { %>
        <% products.forEach(product => { %>
          <div class="col-md-4">
            <div style="background: #1a1a1a; padding: 2rem; border-radius: 10px; border: 1px solid #333; transition: transform 0.3s; height: 100%;" onmouseover="this.style.transform='translateY(-5px)'; this.style.borderColor='#E8BCB5'" onmouseout="this.style.transform='translateY(0)'; this.style.borderColor='#333'">
              
              <!-- Product Image -->
              <div style="position: relative; margin-bottom: 1rem;">
                <img src="<%= product.image %>" alt="<%= product.name %>" style="width: 100%; height: 200px; object-fit: cover; border-radius: 8px;">
                <% if (product.featured) { %>
                  <span style="position: absolute; top: 10px; right: 10px; background: #E8BCB5; color: #111; padding: 0.3rem 0.8rem; border-radius: 20px; font-size: 0.75rem; font-weight: 600;">FEATURED</span>
                <% } %>
              </div>

              <!-- Product Info -->
              <div style="display: flex; justify-content: space-between; align-items: center; margin-bottom: 0.5rem;">
                <h3 style="color: #E8BCB5; font-size: 1.5rem; margin: 0;"><%= product.name %></h3>
                <span style="background: #333; color: #E8BCB5; padding: 0.3rem 0.8rem; border-radius: 5px; font-size: 0.8rem;"><%= product.category %></span>
              </div>

              <p style="color: #ccc; font-size: 0.9rem; line-height: 1.5; margin-bottom: 1rem;"><%= product.description %></p>

              <!-- Price and Stock -->
              <div style="display: flex; justify-content: space-between; align-items: center; margin-bottom: 1rem;">
                <p style="color: #fff; font-size: 1.8rem; font-weight: bold; margin: 0;">$<%= product.price %></p>
                <% if (product.inStock) { %>
                  <span style="color: #5cb85c; font-size: 0.9rem;">✓ In Stock</span>
                <% } else { %>
                  <span style="color: #d9534f; font-size: 0.9rem;">✗ Out of Stock</span>
                <% } %>
              </div>

              <!-- View Details Button -->
              <a href="/products/<%= product._id %>" style="display: block; text-align: center; background: #E8BCB5; color: #111; padding: 0.7rem; border-radius: 5px; text-decoration: none; font-weight: 600; transition: background 0.3s;" onmouseover="this.style.background='#d4a89d'" onmouseout="this.style.background='#E8BCB5'">View Details</a>
            </div>
          </div>
        <% }) %>
      <% } else { %>
        <div class="col-12 text-center" style="padding: 3rem 0;">
          <p style="color: #999; font-size: 1.2rem; margin-bottom: 1rem;">No products found matching your filters.</p>
          <a href="/products" style="background: #E8BCB5; color: #111; padding: 0.7rem 2rem; border-radius: 5px; text-decoration: none; display: inline-block; font-weight: 600;">Clear Filters</a>
        </div>
      <% } %>
    </div>

    <!-- Pagination -->
    <% if (totalPages > 1) { %>
      <div class="text-center mt-5" style="padding: 2rem 0;">
        <div style="display: inline-flex; gap: 0.5rem; flex-wrap: wrap;">
          
          <!-- Previous Button -->
          <% if (currentPage > 1) { %>
            <a href="?page=<%= currentPage - 1 %>&category=<%= query.category || '' %>&priceMin=<%= query.priceMin || '' %>&priceMax=<%= query.priceMax || '' %>&limit=<%= limit %>" 
               style="padding: 0.7rem 1.2rem; background: #333; color: #fff; border-radius: 5px; text-decoration: none; border: 1px solid #444;">← Previous</a>
          <% } %>

          <!-- Page Numbers -->
          <% for(let i = 1; i <= totalPages; i++) { %>
            <% if (i === 1 || i === totalPages || (i >= currentPage - 2 && i <= currentPage + 2)) { %>
              <a href="?page=<%= i %>&category=<%= query.category || '' %>&priceMin=<%= query.priceMin || '' %>&priceMax=<%= query.priceMax || '' %>&limit=<%= limit %>" 
                 style="padding: 0.7rem 1.2rem; <%= i === currentPage ? 'background: #E8BCB5; color: #111; font-weight: 600;' : 'background: #333; color: #fff;' %> border-radius: 5px; text-decoration: none; border: 1px solid #444;"><%= i %></a>
            <% } else if (i === currentPage - 3 || i === currentPage + 3) { %>
              <span style="padding: 0.7rem 1.2rem; color: #666;">...</span>
            <% } %>
          <% } %>

          <!-- Next Button -->
          <% if (currentPage < totalPages) { %>
            <a href="?page=<%= currentPage + 1 %>&category=<%= query.category || '' %>&priceMin=<%= query.priceMin || '' %>&priceMax=<%= query.priceMax || '' %>&limit=<%= limit %>" 
               style="padding: 0.7rem 1.2rem; background: #333; color: #fff; border-radius: 5px; text-decoration: none; border: 1px solid #444;">Next →</a>
          <% } %>
        </div>

        <!-- Page Info -->
        <p style="color: #999; margin-top: 1rem; font-size: 0.9rem;">Page <%= currentPage %> of <%= totalPages %></p>
      </div>
    <% } %>

  </div>
</section>

<%- include('../partials/footer') %>
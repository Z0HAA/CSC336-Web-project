<%- include('partials/header', { title: 'BeTattoo - Contact Us', page: 'contact', cssFile: 'contact.css' }) %>

<!-- Hero Section -->
<section class="contact-hero d-flex align-items-center justify-content-center text-center text-light">
  <div class="hero-overlay">
    <h1>Contact BeTattoo</h1>
  </div>
</section>

<!-- 2x2 Grid Section -->
<section class="contact-grid">
  <div class="row align-items-stretch">
    <!-- Row 1: Image on left -->
    <div class="col-md-6">
      <img src="/assets/smoker.png" alt="Studio Image" class="grid-image">
    </div>
    <div class="col-md-6 text-col">
      <h3>Contact Information</h3>
      <p><strong>Address:</strong> 123 Tattoo Street, City</p>
      <p><strong>Phone:</strong> +123 456 7890</p>
      <p><strong>Email:</strong> info@betattoo.com</p>
    </div>

    <!-- Row 2: Text on left -->
    <div class="col-md-6 text-col">
      <h3>Send a Message</h3>
      <p>
        Aliquam erat ac ipsum. Integer aliquam purus. Quisque lorem tortor fringilla sed, 
        vestibulum id, eleifend justo vel bibendum sapien massa ac turpis faucibus orci luctus non.
      </p>
    </div>

    <!-- Row 2: Form on right -->
    <div class="col-md-6 text-col">
      <form id="contactForm" novalidate>
        <!-- Name and Email -->
        <div class="row g-3 mb-3">
          <div class="col-md-6">
            <input type="text" class="form-control" id="contactName" placeholder="Your name" required>
            <span class="error-message" id="contactNameError"></span>
          </div>
          <div class="col-md-6">
            <input type="email" class="form-control" id="contactEmail" placeholder="Your e-mail" required>
            <span class="error-message" id="contactEmailError"></span>
          </div>
        </div>

        <!-- Subject -->
        <div class="mb-3">
          <input type="text" class="form-control" id="contactSubject" placeholder="Subject" required>
          <span class="error-message" id="contactSubjectError"></span>
        </div>

        <!-- Message -->
        <div class="mb-3">
          <textarea class="form-control" rows="5" id="contactMessage" placeholder="Message" required></textarea>
          <span class="error-message" id="contactMessageError"></span>
        </div>

        <!-- Submit -->
        <button type="submit" class="btn btn-gold w-100" id="sendMessageBtn">Send a message</button>
      </form>
    </div>
  </div>
</section>

<!-- Logo Section -->
<section class="logo-section">
  <div class="logo-container">
    <img src="/assets/one.png" alt="BeTattoo Logo" class="footer-logo">
  </div>
</section>

<!-- Include contact.js -->
<script src="/js/contact.js"></script>

<%- include('partials/footer') %>
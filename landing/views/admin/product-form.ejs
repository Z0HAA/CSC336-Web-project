<div class="container-fluid">
  <div class="d-flex align-items-center mb-4">
    <a href="/admin/products" class="btn btn-outline-primary me-3">
      <i class="bi bi-arrow-left"></i> Back
    </a>
    <h2 style="color: #E8BCB5; margin: 0;">
      <% if (action === 'add') { %>
        <i class="bi bi-plus-circle"></i> Add New Product
      <% } else { %>
        <i class="bi bi-pencil"></i> Edit Product
      <% } %>
    </h2>
  </div>

  <div class="row justify-content-center">
    <div class="col-lg-8">
      <div class="stat-card">
        <form action="<%= action === 'add' ? '/admin/products/add' : '/admin/products/edit/' + product._id %>" method="POST">
          
          <!-- Product Name -->
          <div class="mb-3">
            <label for="name" class="form-label">Product Name *</label>
            <input type="text" class="form-control" id="name" name="name" 
                   value="<%= product ? product.name : '' %>" 
                   placeholder="e.g., Premium Tattoo" required>
          </div>

          <!-- Description -->
          <div class="mb-3">
            <label for="description" class="form-label">Description *</label>
            <textarea class="form-control" id="description" name="description" 
                      rows="4" placeholder="Describe the product..." required><%= product ? product.description : '' %></textarea>
          </div>

          <!-- Price & Category -->
          <div class="row">
            <div class="col-md-6 mb-3">
              <label for="price" class="form-label">Price ($) *</label>
              <input type="number" class="form-control" id="price" name="price" 
                     value="<%= product ? product.price : '' %>" 
                     placeholder="0.00" step="0.01" min="0" required>
            </div>

            <div class="col-md-6 mb-3">
              <label for="category" class="form-label">Category *</label>
              <select class="form-select" id="category" name="category" required>
                <option value="Basic" <%= product && product.category === 'Basic' ? 'selected' : '' %>>Basic</option>
                <option value="Standard" <%= product && product.category === 'Standard' ? 'selected' : '' %>>Standard</option>
                <option value="Premium" <%= product && product.category === 'Premium' ? 'selected' : '' %>>Premium</option>
                <option value="Custom" <%= product && product.category === 'Custom' ? 'selected' : '' %>>Custom</option>
              </select>
            </div>
          </div>

          <!-- Image Path -->
          <div class="mb-3">
            <label for="image" class="form-label">Image Path *</label>
            <input type="text" class="form-control" id="image" name="image" 
                   value="<%= product ? product.image : '' %>" 
                   placeholder="/assets/img1.jpg" required>
            <small class="text-muted">Enter the path to the image file (e.g., /assets/img1.jpg)</small>
          </div>

          <!-- In Stock & Featured -->
          <div class="row">
            <div class="col-md-6 mb-3">
              <label for="inStock" class="form-label">In Stock *</label>
              <select class="form-select" id="inStock" name="inStock" required>
                <option value="true" <%= product && product.inStock ? 'selected' : '' %>>Yes</option>
                <option value="false" <%= product && !product.inStock ? 'selected' : '' %>>No</option>
              </select>
            </div>

            <div class="col-md-6 mb-3">
              <label for="featured" class="form-label">Featured Product *</label>
              <select class="form-select" id="featured" name="featured" required>
                <option value="false" <%= !product || !product.featured ? 'selected' : '' %>>No</option>
                <option value="true" <%= product && product.featured ? 'selected' : '' %>>Yes</option>
              </select>
            </div>
          </div>

          <!-- Submit Buttons -->
          <div class="d-flex gap-2 mt-4">
            <button type="submit" class="btn btn-primary">
              <i class="bi bi-save"></i> 
              <%= action === 'add' ? 'Add Product' : 'Update Product' %>
            </button>
            <a href="/admin/products" class="btn btn-outline-primary">
              <i class="bi bi-x-circle"></i> Cancel
            </a>
          </div>

        </form>
      </div>
    </div>
  </div>
</div>
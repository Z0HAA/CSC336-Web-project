<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <title><%= title || 'Admin Panel - BeTattoo' %></title>

  <!-- Bootstrap CSS -->
  <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet">
  
  <!-- Bootstrap Icons -->
  <link href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.10.5/font/bootstrap-icons.css" rel="stylesheet">

  <!-- Google Font -->
  <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700&display=swap" rel="stylesheet">

  <!-- Admin CSS -->
  <link rel="stylesheet" href="/css/admin.css">
</head>
<body>

  <!-- Admin Sidebar -->
  <div class="admin-sidebar">
    <div class="sidebar-header">
      <h3><i class="bi bi-shield-lock"></i> Admin Panel</h3>
      <p>BeTattoo Management</p>
    </div>

    <nav class="sidebar-nav">
      <a href="/admin/dashboard" class="nav-link <%= page === 'dashboard' ? 'active' : '' %>">
        <i class="bi bi-speedometer2"></i> Dashboard
      </a>
      <a href="/admin/products" class="nav-link <%= page === 'products' ? 'active' : '' %>">
        <i class="bi bi-box-seam"></i> Products
      </a>
      <a href="/admin/products/add" class="nav-link <%= page === 'add-product' ? 'active' : '' %>">
        <i class="bi bi-plus-circle"></i> Add Product
      </a>
      
      <hr style="border-color: #444; margin: 1rem 0;">
      
      <a href="/" class="nav-link" target="_blank">
        <i class="bi bi-globe"></i> View Website
      </a>
    </nav>

    <div class="sidebar-footer">
      <small>© 2025 BeTattoo</small>
    </div>
  </div>

  <!-- Main Content Area -->
  <div class="admin-content">
    <!-- Top Bar -->
    <div class="admin-topbar">
      <button class="btn btn-link toggle-sidebar" id="sidebarToggle">
        <i class="bi bi-list"></i>
      </button>
      <div class="ms-auto d-flex align-items-center gap-3">
        <span class="text-light"><i class="bi bi-person-circle"></i> <%= user ? user.username : 'Admin' %></span>
        <a href="/admin/logout" class="btn btn-sm btn-outline-danger">
          <i class="bi bi-box-arrow-right"></i> Logout
        </a>
      </div>
    </div>

    <!-- Page Content -->
    <div class="admin-body">
      <%- body %>
    </div>
  </div>

  <!-- Bootstrap JS -->
  <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js"></script>
  
  <!-- jQuery -->
  <script src="https://code.jquery.com/jquery-3.7.1.min.js"></script>

  <!-- Admin JS -->
  <script src="/js/admin.js"></script>

  <!-- Page-specific scripts -->
  <% if (locals.pageScript) { %>
    <script src="/js/<%= pageScript %>"></script>
  <% } %>

</body>
</html>